{
  "அலுவல்": {
    "meaning": "அரசு அல்லது நிறுவனப் பணி, கடமை, தொழில் (Official duty / Business)",
    "synonyms": ["பணி", "கடமை", "வினை", "கருமம்"],
    "english": "Official / Office work"
  },
  "சுற்றறிக்கை": {
    "meaning": "பலருக்கும் பொதுவாக அனுப்பப்படும் அலுவல் அறிவிப்பு (Circular)",
    "synonyms": ["பொதுஅறிவிப்பு", "அறிக்கை", "சுற்றுமடல்"],
    "english": "Circular"
  },
  "குறிப்பாணை": {
    "meaning": "அலுவலக உள்ளகத் தகவல் அல்லது நினைவூட்டல் குறிப்பு (Memorandum)",
    "synonyms": ["நினைவுக் குறிப்பு", "அலுவல் குறிப்பு"],
    "english": "Memorandum"
  },
  "ஒப்புதல்": {
    "meaning": "இசைவு அளித்தல், ஏற்றுக்கொள்ளுதல் (Approval / Consent)",
    "synonyms": ["இசைவு", "ஏற்பு", "அனுமதி"],
    "english": "Approval"
  },
  "ஆவணம்": {
    "meaning": "சான்றாகப் பயன்படும் எழுத்துப் படிவம் அல்லது பதிவு (Document / Record)",
    "synonyms": ["பதிவுரு", "சான்றுப் படிவம்", "ஏடு"],
    "english": "Document"
  },
  "நடவடிக்கை": {
    "meaning": "ஒரு செயலை நிறைவேற்ற எடுக்கும் முயற்சி அல்லது செயல்பாடு (Action / Proceeding)",
    "synonyms": ["செயல்பாடு", "முயற்சி", "நடப்பு"],
    "english": "Action / Proceeding"
  },
  "பரிந்துரை": {
    "meaning": "ஒருவரை அல்லது ஒரு கருத்தை ஆதரித்துப் பேசும்/எழுதும் உரை (Recommendation)",
    "synonyms": ["முன்மொழிவு", "ஆதரவுரை"],
    "english": "Recommendation"
  },
  "தொகுப்பு": {
    "meaning": "பலவற்றை ஒன்றாகச் சேர்த்த அமைப்பு (Compilation / Collection)",
    "synonyms": ["திரட்டு", "கோவை", "கலவை"],
    "english": "Compilation"
  },
  "இணைப்பு": {
    "meaning": "கடிதம் அல்லது ஆவணத்துடன் சேர்க்கப்படும் கூடுதல் தாள் (Attachment / Enclosure)",
    "synonyms": ["சேர்க்கை", "உள்ளிணைப்பு"],
    "english": "Attachment / Enclosure"
  },
  "கையொப்பம்": {
    "meaning": "ஒருவரின் ஒப்புதலைக் குறிக்கும் கையெழுத்து (Signature)",
    "synonyms": ["கையெழுத்து", "ஒப்பம்"],
    "english": "Signature"
  },
  "அரசாணை": {
    "meaning": "அரசாங்கத்தால் வெளியிடப்படும் அதிகாரப்பூர்வ ஆணை (Government Order)",
    "synonyms": ["அரசு ஆணை", "ஆட்சி ஆணை"],
    "english": "Government Order (G.O.)"
  },
  "தீர்மானம்": {
    "meaning": "கூட்டத்தில் விவாதித்து எடுக்கப்படும் இறுதி முடிவு (Resolution)",
    "synonyms": ["முடிவு", "துணிபு", "ஏற்புரை"],
    "english": "Resolution"
  },
  "அறிக்கை": {
    "meaning": "ஒரு நிகழ்வு அல்லது ஆய்வு குறித்த விரிவான தகவல் (Report)",
    "synonyms": ["விவரணம்", "செய்திமடல்"],
    "english": "Report"
  },
  "விண்ணப்பம்": {
    "meaning": "ஒரு வேண்டுகோளை முன்வைத்து எழுதும் மனு (Application)",
    "synonyms": ["வேண்டுகோள்", "மனு", "கோரிக்கை"],
    "english": "Application"
  },
  "சான்றிதழ்": {
    "meaning": "ஒருவரின் தகுதி அல்லது நிகழ்வை உறுதிப்படுத்தும் ஆவணம் (Certificate)",
    "synonyms": ["உறுதிச்சீட்டு", "நற்சான்று"],
    "english": "Certificate"
  },
  "தணிக்கை": {
    "meaning": "வரவு செலவு கணக்குகள் மற்றும் ஆவணங்களைச் சரிபார்த்தல் (Audit)",
    "synonyms": ["கணக்காய்வு", "சரிபார்ப்பு"],
    "english": "Audit"
  },
  "நிதி ஒதுக்கீடு": {
    "meaning": "ஒரு திட்டத்திற்காக ஒதுக்கப்படும் பணத்தொகை (Budget Allocation)",
    "synonyms": ["பண ஒதுக்கீடு", "நிதிப்பகிர்வு"],
    "english": "Fund Allocation"
  },
  "செயலர்": {
    "meaning": "ஒரு அமைப்பு அல்லது துறையின் நிர்வாகப் பொறுப்பாளர் (Secretary)",
    "synonyms": ["செயலாளர்", "நிர்வாகி"],
    "english": "Secretary"
  },
  "தலைவர்": {
    "meaning": "ஒரு நிறுவனம் அல்லது கூட்டத்திற்குத் தலைமை தாங்குபவர் (President / Chairperson)",
    "synonyms": ["முதல்வர்", "இயக்குநர்", "அவைத்தலைவர்"],
    "english": "President / Chairman"
  },
  "கூட்டறிக்கை": {
    "meaning": "கூட்டத்தில் பேசப்பட்ட மற்றும் தீர்மானிக்கப்பட்ட விவரங்களின் பதிவு (Minutes of Meeting)",
    "synonyms": ["நடவடிக்கைக் குறிப்பு", "கூட்டக் குறிப்பு"],
    "english": "Minutes of Meeting"
  }
}
